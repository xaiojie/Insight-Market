{
  "name": "insight-market",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "concurrently -n api,web \"pnpm -C apps/api dev\" \"pnpm -C apps/web dev\"",
    "build": "pnpm -C apps/web build",
    "lint": "pnpm -C apps/web lint",
    "db:migrate": "pnpm -C apps/api prisma migrate dev",
    "db:seed": "pnpm -C apps/api prisma db seed",
    "test": "pnpm -C apps/api test"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
