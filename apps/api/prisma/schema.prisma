generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BANNED
}

enum MarketStatus {
  DRAFT
  LIVE
  CLOSED
  RESOLVING
  DISPUTE
  SETTLED
}

enum TradeSide {
  YES
  NO
}

enum DisputeStatus {
  OPEN
  ACCEPTED
  REJECTED
}

model User {
  id        Int        @id @default(autoincrement())
  email     String     @unique
  password  String
  nickname  String
  region    String?
  language  String     @default("zh")
  role      UserRole   @default(USER)
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  wallet    Wallet?
  trades    Trade[]
  positions Position[]
  disputes  Dispute[]
}

model Wallet {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique
  pointsBalance Float   @default(0)
  pointsLocked  Float   @default(0)
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id])
}

model Market {
  id                Int           @id @default(autoincrement())
  title             String
  description       String
  category          String
  status            MarketStatus  @default(DRAFT)
  endTime           DateTime
  disputeEndTime    DateTime
  resolutionSource  String
  resolutionRule    String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  pool              AmmPool?
  trades            Trade[]
  positions         Position[]
  resolution        Resolution?
  disputes          Dispute[]
  priceHistory      PriceHistory[]
}

model AmmPool {
  id         Int      @id @default(autoincrement())
  marketId   Int      @unique
  yesReserve Float
  noReserve  Float
  feeRate    Float    @default(0.01)
  updatedAt  DateTime @updatedAt
  market     Market   @relation(fields: [marketId], references: [id])
}

model Trade {
  id            Int       @id @default(autoincrement())
  userId        Int
  marketId      Int
  side          TradeSide
  pointsIn      Float
  sharesOut     Float
  priceYesBefore Float
  priceNoBefore  Float
  priceYesAfter  Float
  priceNoAfter   Float
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id])
  market        Market    @relation(fields: [marketId], references: [id])
}

model Position {
  id         Int      @id @default(autoincrement())
  userId     Int
  marketId   Int
  yesShares  Float    @default(0)
  noShares   Float    @default(0)
  cost       Float    @default(0)
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id])
  market     Market   @relation(fields: [marketId], references: [id])

  @@unique([userId, marketId])
}

model Resolution {
  id          Int      @id @default(autoincrement())
  marketId    Int      @unique
  result      TradeSide
  evidenceUrl String
  note        String
  operatorId  Int
  createdAt   DateTime @default(now())
  market      Market   @relation(fields: [marketId], references: [id])
}

model Dispute {
  id         Int           @id @default(autoincrement())
  marketId   Int
  userId     Int
  stake      Float
  reason     String
  status     DisputeStatus @default(OPEN)
  resultNote String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  market     Market        @relation(fields: [marketId], references: [id])
  user       User          @relation(fields: [userId], references: [id])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  action    String
  detail    String
  operator  String
  createdAt DateTime @default(now())
}

model PriceHistory {
  id        Int      @id @default(autoincrement())
  marketId  Int
  yesPrice  Float
  noPrice   Float
  createdAt DateTime @default(now())
  market    Market   @relation(fields: [marketId], references: [id])
}
